# HomeWise AI — environment template (no real values; safe to commit).
# Copy to .env.local and fill in locally. .env.local is git-ignored.

# Meta Model API key for AI explanations. Read server-side only, at call
# time, by lib/ai/metaClient.ts. Never commit a real key.
MODEL_API_KEY=

# Kill switch for AI explanations. Production stays disabled unless this is
# exactly "true" (missing or invalid fails closed). Outside production the
# feature defaults on; set "false" to disable locally.
AI_EXPLAIN_ENABLED=

# Opt-in server diagnostics for POST /api/explain (timings, failure
# categories, token counts only — never figures, prompts, or secrets).
# Server-only: never use a NEXT_PUBLIC_ variable. Any value other than
# exactly "1" means disabled. Do not enable automatically in production.
HOMEWISE_AI_DIAGNOSTICS=

# Experimental reasoning-effort override for controlled latency testing
# (T5a.2-I). Server-only: never use a NEXT_PUBLIC_ variable. Only the
# exact value "minimal" changes behavior; unset, empty, "low", "none",
# and anything else all use the default "low". This is an experiment
# setting, not a production recommendation.
HOMEWISE_AI_EFFORT=
